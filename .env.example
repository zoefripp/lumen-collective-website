# Copy to .env.local for local testing. In production, set these in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# Passcode that unlocks the hidden /tools section
TOOLS_PASSCODE=

# Microsoft 365 app registration used to email completed PDFs
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Mailbox the PDF is sent from, and the address it is sent to
TOOLS_MAIL_FROM=
TOOLS_MAIL_TO=
